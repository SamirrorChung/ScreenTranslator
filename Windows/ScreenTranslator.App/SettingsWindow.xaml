<Window x:Class="ScreenTranslator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="螢幕翻譯"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="White">
    <StackPanel Margin="20">
        <TextBlock Text="來源語言" Margin="0,0,0,4"/>
        <ComboBox x:Name="LanguageBox" Margin="0,0,0,14"/>

        <TextBlock Text="模型" Margin="0,0,0,4"/>
        <TextBox x:Name="ModelBox" Margin="0,0,0,14"/>

        <TextBlock Text="Ollama 位址" Margin="0,0,0,4"/>
        <TextBox x:Name="UrlBox" Margin="0,0,0,4"/>
        <TextBlock Text="目標語言是繁體中文。模型需已存在於 Ollama，例如 qwen2.5:7b。"
                   TextWrapping="Wrap"
                   Foreground="#666666"
                   FontSize="12"
                   Margin="0,0,0,14"/>

        <DockPanel Margin="0,0,0,14" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Text="遮罩透明度" VerticalAlignment="Center"/>
            <TextBlock DockPanel.Dock="Right"
                       Text="{Binding OpacityPercent}"
                       Width="44"
                       TextAlignment="Right"
                       VerticalAlignment="Center"
                       FontFamily="Consolas"/>
            <Slider x:Name="OpacitySlider" Minimum="0.2" Maximum="1" Margin="12,0,12,0" VerticalAlignment="Center"/>
        </DockPanel>

        <TextBlock Text="{Binding RegionDescription}" Foreground="#666666" Margin="0,0,0,4"/>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding OcrWarning}" TextWrapping="Wrap" Foreground="#E07A00" FontSize="14" Margin="0,0,0,14">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Orientation="Horizontal">
            <Button Content="圈選區域" MinWidth="96" Padding="12,6" Margin="0,0,8,0" Click="OnSelectRegion"/>
            <Button Content="{Binding ToggleLabel}" MinWidth="96" Padding="12,6" IsDefault="True" Click="OnToggle"/>
            <Button Content="紀錄" MinWidth="96" Padding="12,6" Margin="8,0,0,0" Click="OnShowLog"/>
        </StackPanel>
    </StackPanel>
</Window>
